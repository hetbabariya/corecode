# Coding Agent Configuration
# Copy this file to .env and fill in your values

# LLM Provider: gemini | openrouter | cerebras | zenmux | omniroute
CODING_AGENT_LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
# Get key at https://aistudio.google.com/apikey
CODING_AGENT_LLM_MODEL=gemini-2.5-flash
CODING_AGENT_LLM_API_KEY=your-gemini-api-key-here
# API Key Pool — comma-separated for rotation on 429 rate limits
# CODING_AGENT_LLM_API_KEYS=key1,key2,key3,key4,key5

# --- OpenRouter (openai-compatible proxy) ---
# Get key at https://openrouter.ai/keys
# CODING_AGENT_OPENROUTER_API_KEY=sk-or-v1-xxxx
# CODING_AGENT_OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
# CODING_AGENT_OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Cerebras (fast inference) ---
# Get key at https://cloud.cerebras.ai/
# CODING_AGENT_CEREBRAS_API_KEY=csk-xxxx
# CODING_AGENT_CEREBRAS_API_KEYS=csk-key1,csk-key2
# CODING_AGENT_CEREBRAS_MODEL=llama-3.3-70b

# --- ZenMux (OpenAI-compatible proxy) ---
# Get key at https://zenmux.ai/
# CODING_AGENT_ZENMUX_API_KEY=sk-ai-v1-xxxx
# CODING_AGENT_ZENMUX_API_KEYS=sk-ai-v1-key1,sk-ai-v1-key2
# CODING_AGENT_ZENMUX_MODEL=stepfun/step-3.7-flash-free
# CODING_AGENT_ZENMUX_BASE_URL=https://zenmux.ai/api/v1

# --- OmniRoute (free AI gateway, 50+ providers) ---
# Install: npm install -g omniroute && omniroute
# Dashboard: http://localhost:20128
# CODING_AGENT_OMNIROUTE_API_KEY=your-omniroute-key
# CODING_AGENT_OMNIROUTE_API_KEYS=key1,key2
# CODING_AGENT_OMNIROUTE_MODEL=auto
# CODING_AGENT_OMNIROUTE_BASE_URL=http://localhost:20128/v1

# Agent Configuration
CODING_AGENT_MAX_ITERATIONS=20
CODING_AGENT_MAX_TOKENS=100000
CODING_AGENT_PERMISSION_LEVEL=write

# Budgets
CODING_AGENT_MAX_COST_PER_SESSION=5.0
CODING_AGENT_MAX_TIME_PER_TASK=300

# Sandbox Configuration
# Execution mode: sandbox (Docker isolation) | host (direct execution)
CODING_AGENT_EXEC_MODE=sandbox
CODING_AGENT_SANDBOX_TIMEOUT=30
CODING_AGENT_SANDBOX_MEMORY_LIMIT=512m
CODING_AGENT_SANDBOX_IMAGE=coding-agent-sandbox:latest

# Logging
CODING_AGENT_LOG_LEVEL=INFO
CODING_AGENT_LOG_FILE=agent.log

# Database
CODING_AGENT_DB_PATH=~/.coding-agent/sessions.db
