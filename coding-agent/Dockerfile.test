FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .

RUN pip install --no-cache-dir pip-tools && \
    pip-sync \
    && pip install pytest

USER root
WORKDIR /workspace

COPY . .

CMD ["pytest", "tests", "-v"]